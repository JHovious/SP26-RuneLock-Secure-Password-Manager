<?xml version="1.0" encoding="UTF-8"?>
<project name="runelock" default="run" basedir=".">

    <!-- CONFIGURATION -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="main.class" value="controller.App"/>


    <!-- Detect OS -->
    <condition property="is.windows">
        <os family="windows"/>
    </condition>

    <condition property="is.mac">
        <os family="mac"/>
    </condition>

    <condition property="is.linux">
        <os family="unix"/>
    </condition>
    
    <!-- Set JavaFX home based on OS -->
    <condition property="javafx.home" value="C:/javafx-sdk-21">
        <isset property="is.windows"/>
    </condition>

    <condition property="javafx.home" value="/usr/share/openjfx">
        <isset property="is.linux"/>
    </condition>

    <condition property="javafx.home" value="/opt/homebrew/opt/javafx/libexec">
        <isset property="is.mac"/>
    </condition>

    <!-- JavaFX lib folder -->
    <property name="javafx.lib" value="${javafx.home}/lib"/>



    <!-- JAVAFX INSTALLATION TASKS -->
    <target name="install-javafx" description="Install JavaFX depending on OS">

        <!-- macOS -->
        <condition property="install.cmd" value="brew install javafx">
            <isset property="is.mac"/>
        </condition>

        <!-- Linux -->
        <condition property="install.cmd" value="sudo apt install -y openjfx">
            <and>
                <isset property="is.linux"/>
                <available file="/usr/bin/apt"/>
            </and>
        </condition>

        <!-- Windows -->
        <condition property="install.cmd" value="echo Please install JavaFX manually from https://openjfx.io if it's not already installed.">
            <isset property="is.windows"/>
        </condition>

        <echo message="Running JavaFX installation command: ${install.cmd}"/>
        <exec executable="sh" osfamily="unix">
            <arg value="-c"/>
            <arg value="${install.cmd}"/>
        </exec>

        <exec executable="cmd" osfamily="windows">
            <arg value="/c"/>
            <arg value="${install.cmd}"/>
        </exec>

    </target>


    <!-- CLEAN & PREPARE BUILD DIR -->

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="prepare">
        <mkdir dir="${build.dir}"/>
        
        <!-- Copy resources and images -->
        <copy todir="${build.dir}">
            <fileset dir="src">
                <include name="images/**"/>
            </fileset>
        </copy>
    </target>


    <!-- COMPILE SOURCE CODE -->
    <target name="compile" depends="prepare">
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <!-- JavaFX -->
                <fileset dir="${javafx.lib}" includes="*.jar"/>
                
                <!-- Jackson -->
                <fileset dir="dist/lib" includes="jackson-*.jar"/>
            </classpath>
        </javac>
    </target>


    <!-- RUN APPLICATION -->
    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true">

            <!-- JavaFX module path -->
            <jvmarg value="--module-path"/>
            <jvmarg value="${javafx.lib}"/>

            <jvmarg value="--add-modules=javafx.controls,javafx.fxml"/>

            <classpath>
                <pathelement path="${build.dir}"/>
                <!-- JavaFX -->
                <fileset dir="${javafx.lib}" includes="*.jar"/>
                
                <!-- Jackson -->
                <fileset dir="dist/lib" includes="jackson-*.jar"/>
            </classpath>

        </java>
    </target>

</project>
